#!/usr/bin/env bash
# .env.example — Variáveis sensíveis da plataforma _heck
#
# Copie para scripts/.env (gitignored) e preencha os valores reais.
# NUNCA comite scripts/.env.
#
# Os scripts apply.sh e destroy.sh fazem "source scripts/.env" automaticamente.
# Alternativa: exportar manualmente antes de rodar os scripts.

export TF_VAR_pg_admin_password="MUDE_ISSO_senha_forte_min16chars"
export TF_VAR_iai_device_token="MUDE_ISSO_device_token_iai"
export TF_VAR_getchat_anthropic_api_key="sk-ant-MUDE_ISSO"

# Opcionais para Tradux AI / Keycloak dev.
# Sobrescreva antes de usar fora de um ambiente descartavel.
export TF_VAR_keycloak_admin_password="MUDE_ISSO_keycloak_admin"
export TF_VAR_traduxai_nextauth_secret="MUDE_ISSO_nextauth_secret"
export TF_VAR_traduxai_keycloak_client_secret=""
