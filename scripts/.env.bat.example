@echo off
rem Copie para scripts\.env.bat e preencha os valores reais.
rem NUNCA comite scripts\.env.bat.

set "TF_VAR_pg_admin_password=MUDE_ISSO_senha_forte_min16chars"
set "TF_VAR_iai_device_token=MUDE_ISSO_device_token_iai"
set "TF_VAR_getchat_anthropic_api_key=sk-ant-MUDE_ISSO"

rem Opcionais para Tradux AI / Keycloak dev.
rem Sobrescreva antes de usar fora de um ambiente descartavel.
set "TF_VAR_keycloak_admin_password=MUDE_ISSO_keycloak_admin"
set "TF_VAR_traduxai_nextauth_secret=MUDE_ISSO_nextauth_secret"
set "TF_VAR_traduxai_keycloak_client_secret="

rem Opcional: preencher para aplicar tambem os Deployments da app.
rem Sem isso, o script deixa o deploy da aplicacao para a pipeline GitHub Actions.
set "ACR_NAME=acrheckiodev"
set "TRADUXAI_IMAGE_TAG="
